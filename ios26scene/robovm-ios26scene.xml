<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoboVM AOT configuration for 燃烧的蔬菜3HD — iOS 26 target, UIScene flavour.

  This is robovm-ios26.xml with three edits:
    * <mainClass> points at the scene launcher.
    * <iosInfoPList> points at Info-scene.plist.xml, which declares
      UIApplicationSceneManifest.
    * <executableName> differs so the two flavours cannot overwrite each other
      in the same build directory.

  Everything else — arm64, MetalANGLE, the seven arm64 frameworks, the
  forceLinkClasses set — is identical, because the game code and the libGDX
  bridge are identical. See robovm-ios26.xml for the full rationale.
-->
<config>
    <executableName>Veggies3HDScene</executableName>
    <mainClass>com.soco.veggies3_4399.ios26.scene.IOSLauncher26Scene</mainClass>
    <os>ios</os>
    <arch>arm64</arch>
    <target>ios</target>
    <iosInfoPList>Info-scene.plist.xml</iosInfoPList>

    <!--
      Speed knobs. Each one was read out of the RoboVM 2.3.19 bytecode, not
      guessed; see README-iOS26.md §5.6 for the javap evidence.

      treeShaker
        Config.getTreeShakerMode() falls back to TreeShakerMode.none when the
        field is null, i.e. by default RoboVM compiles *every method of every
        reachable class* into LLVM and then hands it to clang. DependencyGraph's
        constructor shows what "conservative" actually skips: while walking the
        dependency edges, a MethodNode with isWeaklyLinked()==true is neither
        added to reachableNodes nor enqueued, so its whole subtree drops out.
        "aggressive" keeps only isStronglyLinked() methods plus <init>.

        conservative, not aggressive: this game reaches libGDX through its own
        SocoTexture / SocoFreeTypeFontGenerator shims and through reflection-free
        direct calls, but an aggressive pass can strip a method that only the
        ObjC plugin or a framework callback would have reached, and the failure
        mode is a runtime crash on device — not something a Windows box can test.
        conservative is the largest cut that cannot remove a strongly-linked
        method.

      threads
        Left at the default on purpose. Config.threads carries no @Element
        annotation, so <threads> is not a legal element and Simple-XML would
        reject the whole file. The default is Runtime.availableProcessors(),
        which is 3 on a macos-15 runner — the same value we would have written.

      cache
        Also left at the default. Config.clean carries no @Element annotation
        either, and the default (false) is already what lets an incremental
        rebuild on a real Mac print "No classes were modified. Skipping
        compilation and linking."
    -->
    <treeShaker>conservative</treeShaker>

    <resources>
        <resource>
            <directory>resources</directory>
            <includes>
                <include>**</include>
            </includes>
            <skipPngCrush>true</skipPngCrush>
        </resource>
    </resources>

    <!--
      Same roots as robovm-ios26.xml, minus every org.robovm.apple pattern.

      The scene delegate is the one class here that UIKit really does
      instantiate by name — from UISceneDelegateClassName in
      Info-scene.plist.xml. com.soco.** already covers it, and unlike a
      Class.forName call the ObjC runtime handshake is visible to the ObjC
      plugin, which registers custom classes before linking. It is listed
      explicitly anyway so the requirement survives if that pattern is ever
      narrowed.

      Dropping org.robovm.apple.* is deliberate: the app references 97 Apple
      binding classes out of 14,848, and force-linking whole packages pushed
      the AOT set to ~5,400 classes, which ran past 89 minutes on CI. See the
      long comment in ios26/robovm-ios26.xml for both failure runs.
    -->
    <forceLinkClasses>
        <pattern>com.soco.**</pattern>
        <pattern>com.badlogic.gdx.**</pattern>
        <pattern>com.esotericsoftware.**</pattern>
        <pattern>com.main.**</pattern>
        <pattern>com.net.**</pattern>
        <pattern>com.protocol.**</pattern>
    </forceLinkClasses>

    <frameworkPaths>
        <path>libs/ios26</path>
    </frameworkPaths>

    <frameworks>
        <framework>gdx</framework>
        <framework>ObjectAL</framework>
        <framework>gdx-freetype</framework>
        <framework>MetalANGLEKit</framework>
        <framework>libGLESv2</framework>
        <framework>libEGL</framework>
        <framework>libfeature_support</framework>
        <framework>Metal</framework>
        <framework>UIKit</framework>
        <framework>QuartzCore</framework>
        <framework>CoreGraphics</framework>
        <framework>CoreFoundation</framework>
        <framework>CoreText</framework>
        <framework>CoreAudio</framework>
        <framework>CoreMedia</framework>
        <framework>Foundation</framework>
        <framework>AudioToolbox</framework>
        <framework>AVFoundation</framework>
        <framework>OpenAL</framework>
        <framework>SystemConfiguration</framework>
        <framework>GameController</framework>
    </frameworks>

    <libs>
        <lib>z</lib>
        <lib>c++</lib>
    </libs>
</config>
