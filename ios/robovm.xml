<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoboVM AOT configuration for 燃烧的蔬菜3HD (iOS port).

  The game code is not recompiled: it arrives as libs/game-ios.jar (the original
  dex, with UI_chongzhi.isIOS flipped to true). Because RoboVM strips every class
  it cannot see being referenced, forceLinkClasses keeps the reflective edges of
  the original runtime alive: Lua-style data tables, Spine runtime lookups and
  the UI_* screens are all reached through string names in the original code.
-->
<config>
    <executableName>Veggies3HD</executableName>
    <mainClass>com.soco.veggies3_4399.ios.IOSLauncher</mainClass>
    <os>ios</os>
    <arch>thumbv7</arch>
    <target>ios</target>
    <iosInfoPList>Info.plist.xml</iosInfoPList>

    <resources>
        <resource>
            <directory>resources</directory>
            <includes>
                <include>**</include>
            </includes>
            <skipPngCrush>true</skipPngCrush>
        </resource>
    </resources>

    <forceLinkClasses>
        <pattern>com.soco.**</pattern>
        <pattern>com.badlogic.gdx.**</pattern>
        <pattern>com.esotericsoftware.**</pattern>
        <pattern>com.jcraft.**</pattern>
        <pattern>com.main.**</pattern>
        <pattern>com.net.**</pattern>
        <pattern>com.protocol.**</pattern>
        <pattern>javazoom.**</pattern>
    </forceLinkClasses>

    <libs>
        <lib>z</lib>
        <lib>libs/ios/libgdx.a</lib>
        <lib>libs/ios/libObjectAL.a</lib>
        <lib>libs/ios/libgdx-freetype.a</lib>
    </libs>

    <frameworks>
        <framework>UIKit</framework>
        <framework>OpenGLES</framework>
        <framework>QuartzCore</framework>
        <framework>CoreGraphics</framework>
        <framework>CoreFoundation</framework>
        <framework>CoreText</framework>
        <framework>Foundation</framework>
        <framework>AudioToolbox</framework>
        <framework>AVFoundation</framework>
        <framework>OpenAL</framework>
        <framework>SystemConfiguration</framework>
    </frameworks>
</config>
