<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoboVM AOT configuration for 燃烧的蔬菜3HD — iOS 26 target.

  Differences from the iOS <= 10 configuration (robovm.xml):
    * <arch> is arm64, because iOS 11 dropped 32-bit executables entirely and
      iOS 26 has no armv7 support at all.
    * Graphics go through MetalANGLE: iOS 26 no longer ships an OpenGL ES
      driver, so libGDX's iosgl backend cannot present a frame. The
      gdx-backend-robovm-metalangle backend maps GLES2/3 calls onto Metal via
      ANGLE, and its four frameworks (MetalANGLEKit, libGLESv2, libEGL,
      libfeature_support) are linked instead of OpenGLES.
    * libGDX 1.14.2 ships prebuilt arm64 frameworks rather than .a archives,
      so <frameworkPaths> points at libs/ios26 and each framework is named
      individually. RoboVM resolves <framework> to <path>/<name>.framework/<name>.
    * The game's own classes are still the original dex bytecode (game-ios.jar),
      untouched; the libGDX 1.14.2 API gap is bridged by gdx-1.14.2-ios.jar,
      which is gdx-1.14.2 + gdx-freetype-1.14.2 with 26 members injected by
      tools/src/InjectShim.java.
-->
<config>
    <!--
      RoboVM 2.3.19 only registers three placeholders — app.executable, app.id,
      app.name (Config$Builder). There is no app.mainclass, so the entry point
      and executable name are hard-coded. A leftover ${app.mainclass} would
      surface as "main class not found: ${app.mainclass}" during AOT linking.
    -->
    <executableName>Veggies3HD</executableName>
    <mainClass>com.soco.veggies3_4399.ios26.IOSLauncher26</mainClass>
    <os>ios</os>
    <arch>arm64</arch>
    <target>ios</target>
    <iosInfoPList>Info.plist.xml</iosInfoPList>

    <resources>
        <resource>
            <directory>resources</directory>
            <includes>
                <include>**</include>
            </includes>
            <skipPngCrush>true</skipPngCrush>
        </resource>
    </resources>

    <!--
      RoboVM's tree shaker starts from these roots and keeps everything they
      reference. The game half is listed wholesale because screen classes are
      looked up through data tables (UI name -> constructor) that the reachability
      analysis can follow, but the entry points into those tables are spread over
      150 UI classes; pinning the namespace is cheaper than proving it.

      The Apple half is deliberately NOT `org.robovm.apple.**`.

      That pattern pulls in all 14,848 CocoaTouch binding classes — MetalPS,
      HealthKit, HomeKit, PassKit, CarPlay, ARKit, Vision, Intents, MapKit and
      every other framework in the 2.3.19 bindings, none of which this game
      touches. The first CI run did exactly that and died: with the Gradle
      daemon's default 512 MB heap the AOT compiler spent 52 minutes logging
      "Expiring Daemon because JVM heap space is exhausted" and never produced a
      single class.

      The seven packages below are the ones the app actually references, counted
      by scanning the constant pools of game-core2.jar, gdx-1.14.2-ios.jar and
      the MetalANGLE backend:

          uikit          317 refs     foundation      227
          coregraphics    60          corehaptic       28
          gamecontroller   2          coreanimation     1
          audiotoolbox     1

      That is 3,744 classes instead of 14,848 — a 4x cut. Anything else the
      runtime needs is pulled in by reachability from these roots.
    -->
    <forceLinkClasses>
        <pattern>com.soco.**</pattern>
        <pattern>com.badlogic.gdx.**</pattern>
        <pattern>com.esotericsoftware.**</pattern>
        <pattern>com.main.**</pattern>
        <pattern>com.net.**</pattern>
        <pattern>com.protocol.**</pattern>
        <pattern>javazoom.**</pattern>
        <pattern>org.robovm.apple.uikit.**</pattern>
        <pattern>org.robovm.apple.foundation.**</pattern>
        <pattern>org.robovm.apple.coregraphics.**</pattern>
        <pattern>org.robovm.apple.corehaptic.**</pattern>
        <pattern>org.robovm.apple.gamecontroller.**</pattern>
        <pattern>org.robovm.apple.coreanimation.**</pattern>
        <pattern>org.robovm.apple.audiotoolbox.**</pattern>
    </forceLinkClasses>

    <frameworkPaths>
        <path>libs/ios26</path>
    </frameworkPaths>

    <frameworks>
        <framework>gdx</framework>
        <framework>ObjectAL</framework>
        <framework>gdx-freetype</framework>
        <framework>MetalANGLEKit</framework>
        <framework>libGLESv2</framework>
        <framework>libEGL</framework>
        <framework>libfeature_support</framework>
        <framework>Metal</framework>
        <framework>UIKit</framework>
        <framework>QuartzCore</framework>
        <framework>CoreGraphics</framework>
        <framework>CoreFoundation</framework>
        <framework>CoreText</framework>
        <framework>CoreAudio</framework>
        <framework>CoreMedia</framework>
        <framework>Foundation</framework>
        <framework>AudioToolbox</framework>
        <framework>AVFoundation</framework>
        <framework>OpenAL</framework>
        <framework>SystemConfiguration</framework>
        <framework>GameController</framework>
    </frameworks>

    <libs>
        <lib>z</lib>
        <lib>c++</lib>
    </libs>
</config>
